# SportBeaconAI Environment Variables Sync Template
# Generated by DevOps Automation Agent
# Copy this file to .env.local in each directory and configure values

# =============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vite)
# =============================================================================

# Sentry Error Monitoring
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=v1.0.0
VITE_ENABLE_SENTRY=false

# Firebase Configuration (Frontend) - Vite Environment Variables
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# AI Services (Frontend)
VITE_OPENAI_KEY=sk-your_openai_api_key
VITE_ANTHROPIC_KEY=your_anthropic_api_key
VITE_GOOGLE_AI_KEY=your_google_ai_api_key

# Payment Processing (Frontend)
VITE_STRIPE_KEY=pk_test_your_stripe_publishable_key
VITE_APPLE_PAY_MERCHANT_ID=merchant.com.sportbeacon

# External Services (Frontend)
VITE_BASE_URL=http://localhost:3000
VITE_WEATHER_API_KEY=your_weather_api_key

# =============================================================================
# BACKEND ENVIRONMENT VARIABLES
# =============================================================================

# Firebase Configuration (Backend)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
APPLE_PAY_MERCHANT_ID=merchant.com.sportbeacon

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_s3_bucket_name
S3_BUCKET_NAME=sportsbeacon-media-bucket
MEDIA_CDN_BASE=https://your-cdn-url.com

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key

# JWT Configuration
JWT_SECRET=your_jwt_secret_key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your_slack_bot_token
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_CHANNEL_ID=C1234567890

# GitHub Configuration
GITHUB_TOKEN=your_github_token
GITHUB_ACTOR=your_github_username
GITHUB_SHA=your_commit_sha
GITHUB_REF_NAME=main

# Cursor Configuration
CURSOR_WEBHOOK_URL=https://your_webhook_url

# Weather API
WEATHER_API_KEY=your_weather_api_key

# Admin Configuration
ADMIN_TOKEN=your_admin_token

# Client Configuration
CLIENT_ORIGIN=http://localhost:3000

# Node Environment
NODE_ENV=development

# =============================================================================
# AI SERVICE ENVIRONMENT VARIABLES
# =============================================================================

# AI Model Configuration
AI_MODEL_PROVIDER=openai
AI_MODEL_NAME=gpt-4
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7

# AI Service Keys
OPENAI_API_KEY=sk-your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_AI_API_KEY=your_google_ai_api_key

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000
AI_RATE_LIMIT=100

# =============================================================================
# REQUIRED VARIABLES BY SERVICE
# =============================================================================

# Frontend Required Variables:
# - VITE_FIREBASE_API_KEY
# - VITE_FIREBASE_AUTH_DOMAIN
# - VITE_FIREBASE_PROJECT_ID
# - VITE_FIREBASE_STORAGE_BUCKET
# - VITE_FIREBASE_MESSAGING_SENDER_ID
# - VITE_FIREBASE_APP_ID
# - VITE_STRIPE_KEY
# - VITE_BASE_URL

# Backend Required Variables:
# - FIREBASE_API_KEY
# - FIREBASE_AUTH_DOMAIN
# - FIREBASE_PROJECT_ID
# - FIREBASE_STORAGE_BUCKET
# - FIREBASE_MESSAGING_SENDER_ID
# - FIREBASE_APP_ID
# - STRIPE_SECRET_KEY
# - AWS_ACCESS_KEY_ID
# - AWS_SECRET_ACCESS_KEY
# - OPENAI_API_KEY
# - JWT_SECRET

# AI Service Required Variables:
# - OPENAI_API_KEY
# - AI_MODEL_PROVIDER
# - AI_MODEL_NAME
# - AI_SERVICE_URL

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to each service directory:
#    cp env.local.sync frontend/.env.local
#    cp env.local.sync backend/.env.local
#    cp env.local.sync ai/.env.local

# 2. Configure the required variables for each service

# 3. Test the configuration:
#    - Frontend: npm run dev (should start without errors)
#    - Backend: npm run dev (should connect to Firebase)
#    - AI: python app.py (should start AI service)

# 4. Verify environment variables are loaded:
#    - Frontend: Check browser console for VITE_* variables
#    - Backend: Check server logs for environment validation
#    - AI: Check service logs for API key validation

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Never commit .env.local files to version control
# - Use different API keys for development, staging, and production
# - Rotate API keys regularly
# - Use environment-specific Firebase projects
# - Enable Firebase App Check for production
# - Use Vercel environment variables for production deployments 