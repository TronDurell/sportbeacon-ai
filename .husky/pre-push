#!/usr/bin/env sh
# Pre-push hook for SportBeaconAI
# Runs typecheck and tests for changed files

echo "🔍 Running pre-push checks..."

# Run typecheck
echo "📝 Type checking..."
npm run typecheck
if [ $? -ne 0 ]; then
  echo "❌ Type check failed"
  exit 1
fi

# Run Jest tests for changed files
echo "🧪 Running tests for changed files..."
npm run test:jest -- --changedSince=origin/main --passWithNoTests
if [ $? -ne 0 ]; then
  echo "❌ Tests failed"
  exit 1
fi

echo "✅ Pre-push checks passed!"
