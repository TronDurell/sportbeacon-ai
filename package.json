{
  "name": "sportbeacon-ai",
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "functions",
    "packages/mcp-server"
  ],
  "scripts": {
    "dev": "npm run -ws --if-present dev",
    "build": "turbo run build",
    "build:all": "npm run -ws --if-present build",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test --continue",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "test:clear": "jest --clearCache",
    "test:all": "npm run -ws --if-present test",
    "lint": "turbo run lint --continue",
    "lint:all": "npm run -ws --if-present lint",
    "lint:fix": "node tools/eslint-multi-pass.mjs",
    "lint:fix:frontend": "cd frontend && npx eslint --fix \"src/**/*.{ts,tsx,js,jsx}\"",
    "lint:fix:functions": "cd functions && npx eslint --fix \"src/**/*.ts\"",
    "typecheck:all": "npm run -ws --if-present typecheck",
    "audit:fix": "npm audit fix --workspaces --audit-level=moderate",
    "prepush": "npm run typecheck && npm run lint && npm run test && npm run audit:fix",
    "postdeploy:check:posix": "curl -s https://sportbeacon-ai.web.app | head -n 50",
    "postdeploy:check:powershell": "powershell -Command \"iwr https://sportbeacon-ai.web.app -UseBasicParsing | Select-Object -First 50\"",
    "check:all": "npm run lint:all && npm run typecheck && npm run test:all && npm run build:all",
    "check:types": "npm run -ws --if-present typecheck",
    "check:build": "npm run -ws --if-present build",
    "check:tests": "npm run test:all",
    "validate:web": "npm -w frontend run build && node tools/lighthouse-ci.mjs",
    "validate:functions": "npm -w functions run build",
    "validate:all": "npm run lint:fix:functions && npm run lint:fix:frontend && npm run typecheck:all && npm run test:all && npm run build:all && node tools/generate-report.mjs",
    "lighthouse:pwa": "npm -w frontend run build && node tools/lighthouse-ci.mjs",
    "fix:eslint": "node tools/eslint-multi-pass.mjs",
    "fix:any": "node tools/ts-any-sweeper.mjs",
    "dev:emulators": "firebase emulators:start --import ./.cache/emulator --export-on-exit",
    "emulate": "firebase emulators:start --import=./.cache/emulator --export-on-exit",
    "emulate:firestore": "firebase emulators:start --only firestore",
    "emulate:functions": "firebase emulators:start --only functions",
    "emulators:start": "firebase emulators:start --only firestore,auth --project sportbeaconai-test",
    "emu": "firebase emulators:start --only firestore,auth --project sportbeaconai-test",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:all": "firebase deploy",
    "test:memory-sdk": "cd packages/memory-sdk && npm test",
    "test:e2e:memory-writes": "npm run test:memory-sdk && echo 'Memory writes validated in E2E tests'",
    "test:feedback-coverage": "npm run test:memory-sdk && echo 'Feedback coverage validated'",
    "test:kpi-canary": "node scripts/kpi-monitor.ts canary",
    "test:learning-gates": "node scripts/learning-gates.ts",
    "test:rules": "cd frontend && npm test -- __tests__/memory.rules.test.ts",
    "test:memory": "cd packages/memory-sdk && npm test",
    "mem:test": "npm run test:memory",
    "mem:lint": "cd packages/memory-sdk && npm run lint",
    "mem:build": "cd packages/memory-sdk && npm run build",
    "kpi:collect": "node scripts/kpi-monitor.ts collect",
    "kpi:baseline": "node scripts/kpi-monitor.ts baseline",
    "memory:demo": "cd frontend && npm run dev -- --env MEMORY_ENABLED=true",
    "mcp:dev": "cd packages/mcp-server && npm run dev",
    "mcp:build": "cd packages/mcp-server && npm run build",
    "mcp:start": "cd packages/mcp-server && npm start",
    "agents:test": "npm run mcp:build && firebase emulators:start --only firestore,auth --project sportbeaconai-test & sleep 5 && npm run test:memory-sdk",
    "e2e:emulator": "npm run mcp:build && firebase emulators:start --only firestore,auth,functions --project sportbeaconai-test & sleep 10 && npx playwright test --project=emulator",
    "lint:agents": "cd packages/mcp-server && npm run lint",
    "deploy:agentic": "tsx scripts/deploy-agentic-features.ts",
    "deploy:agentic:staging": "tsx scripts/deploy-agentic-features.ts staging",
    "deploy:agentic:production": "tsx scripts/deploy-agentic-features.ts production",
    "validate:agentic": "tsx scripts/validate-agentic-deployment.js",
    "build:agentic": "npm run mcp:build && npm run build:functions && npm run build:frontend",
    "test:agentic": "npm run mcp:build && npm run test:functions && npm run test:frontend && npm run test:integration",
    "lighthouse:agentic": "npx @lhci/cli autorun --collect.url=https://sportbeacon-ai.web.app",
    "lh:ci": "lhci autorun --collect.staticDistDir=frontend/dist"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@sentry/react": "^10.5.0",
    "@sentry/tracing": "^7.120.4",
    "@stripe/react-stripe-js": "^3.9.1",
    "@stripe/stripe-js": "^7.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-toastify": "^11.0.5",
    "terser": "^5.43.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^30.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-markdown": "^3.0.0",
    "glob": "^11.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.6.0",
    "vite": "^7.0.0",
    "@lhci/cli": "^0.12.0",
    "turbo": "^1.10.0"
  },
  "overrides": {
    "axios": "^1.7.7",
    "ws": "^8.18.0",
    "tar-fs": "^3.0.0",
    "undici": "^6.0.0",
    "esbuild": "^0.25.0",
    "cookie": "^0.7.0",
    "tmp": "^0.2.4"
  }
}
