# Firebase Test Environment Configuration
VITE_FIREBASE_PROJECT_ID=sportbeaconai-test
VITE_FIREBASE_API_KEY=test_api_key
VITE_FIREBASE_AUTH_DOMAIN=sportbeaconai-test.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=sportbeaconai-test.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:test_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-TEST123

# Test-specific settings
VITE_DEV_MODE=true
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug

# Mock external services for testing
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_mock_key_for_testing
VITE_WEATHER_API_KEY=test_weather_key
VITE_SENTRY_DSN=test_sentry_dsn

# Feature flags for testing
VITE_ENABLE_LOCATION_THREADS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DIGESTS=true
