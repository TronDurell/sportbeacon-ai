# Base URL of the canonical FastAPI backend (no trailing slash).
# Local development default:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Firebase web app placeholders. Do not commit real values.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=sportbeacon-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sportbeacon-ai
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id

# Set true only for local emulator development.
VITE_USE_FIREBASE_EMULATORS=false
