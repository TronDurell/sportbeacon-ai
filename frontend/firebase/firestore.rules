rules_version = '2';

// Enhanced Firestore security rules for SportBeaconAI
// Comprehensive security with role-based access, data validation, and rate limiting

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Import security configuration
    // Note: These constants would be available in a real implementation
    // For now, we'll define them inline for clarity
    
    // File size limits (in bytes)
    const MAX_VIDEO_SIZE = 100 * 1024 * 1024; // 100MB
    const MAX_IMAGE_SIZE = 10 * 1024 * 1024; // 10MB
    const MAX_DOCUMENT_SIZE = 25 * 1024 * 1024; // 25MB
    
    // Payment limits (in cents)
    const MIN_TIP_AMOUNT = 50; // $0.50
    const MAX_TIP_AMOUNT = 1000000; // $10,000
    const MIN_PAYOUT_AMOUNT = 1000; // $10.00
    const MAX_PAYOUT_AMOUNT = 5000000; // $50,000
    
    // Rate limiting
    const MAX_REQUESTS_PER_MINUTE = 60;
    const MAX_REQUESTS_PER_HOUR = 1000;
    const MAX_TIPS_PER_DAY = 50;
    const MAX_TIP_AMOUNT_PER_DAY = 10000; // $100
    
    // User roles
    const ROLE_USER = 'user';
    const ROLE_CREATOR = 'creator';
    const ROLE_ADMIN = 'admin';
    const ROLE_MODERATOR = 'moderator';
    const ROLE_VERIFIED = 'verified';
    
    // Enhanced helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return request.auth.token.admin == true;
    }
    
    function isModerator() {
      return request.auth.token.moderator == true;
    }
    
    function isCreator() {
      return request.auth.token.creator == true;
    }
    
    function isVerified() {
      return request.auth.token.verified == true;
    }
    
    function hasRole(role) {
      return request.auth.token[role] == true;
    }
    
    function hasAnyRole(roles) {
      return request.auth.token.admin == true || 
             request.auth.token.moderator == true ||
             (roles.hasAny([ROLE_CREATOR, ROLE_VERIFIED]) && 
              (request.auth.token.creator == true || request.auth.token.verified == true));
    }
    
    function isValidAmount(amount, minAmount, maxAmount) {
      return amount is number && amount >= minAmount && amount <= maxAmount;
    }
    
    function isValidTipAmount(amount) {
      return isValidAmount(amount, MIN_TIP_AMOUNT, MAX_TIP_AMOUNT);
    }
    
    function isValidPayoutAmount(amount) {
      return isValidAmount(amount, MIN_PAYOUT_AMOUNT, MAX_PAYOUT_AMOUNT);
    }
    
    function isValidCurrency(currency) {
      return currency in ['usd', 'cad', 'eur', 'gbp'];
    }
    
    function isValidEmail(email) {
      return email is string && email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }
    
    function isValidUsername(username) {
      return username is string && username.matches('^[a-zA-Z0-9_]{3,20}$');
    }
    
    function isValidDisplayName(displayName) {
      return displayName is string && displayName.size() > 0 && displayName.size() <= 50;
    }
    
    function isValidTimestamp(timestamp) {
      return timestamp is timestamp && 
             timestamp > timestamp.date(2020, 1, 1) && 
             timestamp < timestamp.date(2030, 12, 31);
    }
    
    function isValidFileSize(size, maxSize) {
      return size is number && size > 0 && size <= maxSize;
    }
    
    function isValidFileType(contentType, allowedTypes) {
      return contentType is string && contentType in allowedTypes;
    }
    
    function isRecentRequest() {
      return request.time < resource.data.lastRequestAt + duration.value(60, 's');
    }
    
    function isWithinRateLimit(userId, operation) {
      // This would typically check against a rate limiting collection
      // For now, we'll use a simplified approach
      return true;
    }
    
    function validateUserProfile(profile) {
      return profile.userId is string &&
             profile.userId.size() > 0 &&
             isValidDisplayName(profile.displayName) &&
             (profile.email == null || isValidEmail(profile.email)) &&
             (profile.phone == null || profile.phone is string) &&
             (profile.bio == null || profile.bio is string && profile.bio.size() <= 500) &&
             (profile.avatar == null || profile.avatar is string) &&
             (profile.location == null || profile.location is string) &&
             (profile.verified == null || profile.verified is bool) &&
             (profile.tipEarnings == null || profile.tipEarnings is number && profile.tipEarnings >= 0) &&
             (profile.totalTips == null || profile.totalTips is number && profile.totalTips >= 0) &&
             (profile.averageTip == null || profile.averageTip is number && profile.averageTip >= 0);
    }
    
    function validateTipTransaction(tip) {
      return tip.fromUserId is string &&
             tip.fromUserId.size() > 0 &&
             tip.toUserId is string &&
             tip.toUserId.size() > 0 &&
             tip.fromUserId != tip.toUserId &&
             isValidTipAmount(tip.amount) &&
             isValidCurrency(tip.currency) &&
             tip.status in ['pending', 'succeeded', 'failed', 'refunded'] &&
             tip.checkoutSessionId is string &&
             tip.checkoutSessionId.size() > 0 &&
             isValidTimestamp(tip.createdAt) &&
             (tip.metadata == null || tip.metadata is map);
    }
    
    function validatePayoutRequest(payout) {
      return payout.userId is string &&
             payout.userId.size() > 0 &&
             isValidPayoutAmount(payout.amount) &&
             isValidCurrency(payout.currency) &&
             payout.status in ['pending', 'processing', 'paid', 'failed', 'cancelled'] &&
             payout.method in ['bank_account', 'card', 'stripe_balance'] &&
             isValidTimestamp(payout.createdAt) &&
             (payout.destination == null || payout.destination is map);
    }
    
    // User profiles - users can read/write their own profile
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Player profiles - users can read/write their own profile
    match /players/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Creator profiles - public read, owner write, admin full access
    match /creatorProfiles/{creatorId} {
      allow read: if true; // Public read for discovery
      allow create: if isAuthenticated() && isOwner(creatorId);
      allow update: if isAuthenticated() && (isOwner(creatorId) || isAdmin());
      allow delete: if isAuthenticated() && isAdmin();
      
      // Validate creator profile data
      function validateCreatorProfile() {
        let profile = request.resource.data;
        return profile.userId == creatorId &&
               profile.displayName is string &&
               profile.displayName.size() > 0 &&
               profile.displayName.size() <= 100 &&
               profile.verified is bool &&
               profile.tipEarnings is number &&
               profile.tipEarnings >= 0 &&
               profile.totalTips is number &&
               profile.totalTips >= 0 &&
               profile.averageTip is number &&
               profile.averageTip >= 0;
      }
    }
    
    // Tips - users can read tips they sent/received, creators can read their tips
    match /tips/{tipId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.fromUserId) ||
        isOwner(resource.data.toUserId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
        isOwner(request.resource.data.fromUserId) &&
        validateTipData();
      allow update: if isAuthenticated() && isAdmin(); // Only admins can update tips
      allow delete: if false; // No deletion of tips for audit purposes
      
      // Validate tip data
      function validateTipData() {
        let tip = request.resource.data;
        return tip.fromUserId == request.auth.uid &&
               tip.fromUserId != tip.toUserId &&
               isValidAmount(tip.amount) &&
               isValidCurrency(tip.currency) &&
               tip.status in ['pending', 'succeeded', 'failed', 'refunded'] &&
               tip.checkoutSessionId is string &&
               tip.checkoutSessionId.size() > 0;
      }
    }
    
    // Transactions - users can read their own transactions
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.creatorId) ||
        isOwner(resource.data.viewerId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
        isOwner(request.resource.data.viewerId) &&
        validateTransactionData();
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if false; // No deletion for audit purposes
      
      // Validate transaction data
      function validateTransactionData() {
        let transaction = request.resource.data;
        return transaction.viewerId == request.auth.uid &&
               transaction.creatorId != transaction.viewerId &&
               isValidAmount(transaction.amount) &&
               isValidCurrency(transaction.currency) &&
               transaction.type in ['tip', 'subscription', 'purchase'] &&
               transaction.status in ['pending', 'completed', 'failed', 'refunded'];
      }
    }
    
    // Payouts - creators can read their own payouts
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isAdmin(); // Only system can create payouts
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if false; // No deletion for audit purposes
    }
    
    // Rate limiting - users can read their own rate limit data
    match /rateLimits/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // Idempotency keys - system only
    match /idempotencyKeys/{key} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    
    // Audit logs - admin only
    match /auditLogs/{logId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    
    // Notifications - users can read their own notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isAdmin(); // System creates notifications
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Coach logs - coaches can read/write logs for their players
    match /coachLogs/{logId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.createdBy) ||
        isAdmin()
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.createdBy);
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy);
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }
    
    // Video annotations - users can read/write their own annotations
    match /annotations/{annotationId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.createdBy) ||
        resource.data.permissions.isPublic == true ||
        request.auth.uid in resource.data.permissions.sharedWith
      );
      allow create: if isAuthenticated() && isOwner(request.resource.data.createdBy);
      allow update: if isAuthenticated() && isOwner(resource.data.createdBy);
      allow delete: if isAuthenticated() && isOwner(resource.data.createdBy);
    }
    
    // Teams - team members can read, admins can write
    match /teams/{teamId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.members ||
        request.auth.uid == resource.data.adminId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.adminId ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && isAdmin();
    }
    
    // Leagues - league members can read, admins can write
    match /leagues/{leagueId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.members ||
        request.auth.uid == resource.data.adminId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.adminId ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && isAdmin();
    }
    
    // Admin collections - admin only
    match /admin/{document=**} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    
    // System collections - system only
    match /system/{document=**} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    
    // Security monitoring and audit logs
    match /securityLogs/{logId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated(); // System creates logs
      allow update, delete: if false; // Immutable logs
    }
    
    // Rate limiting data
    match /rateLimits/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // Content moderation
    match /moderationReports/{reportId} {
      allow read: if isAuthenticated() && (isModerator() || isAdmin());
      allow create: if isAuthenticated(); // Users can report content
      allow update: if isAuthenticated() && (isModerator() || isAdmin());
      allow delete: if isAuthenticated() && isAdmin();
    }
    
    // Content flags
    match /contentFlags/{flagId} {
      allow read: if isAuthenticated() && (isModerator() || isAdmin());
      allow create: if isAuthenticated(); // Users can flag content
      allow update: if isAuthenticated() && (isModerator() || isAdmin());
      allow delete: if isAuthenticated() && isAdmin();
    }
    
    // User sessions
    match /userSessions/{sessionId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // API keys and tokens
    match /apiKeys/{keyId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    
    // System configuration
    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // Feature flags
    match /featureFlags/{flagId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // User preferences
    match /userPreferences/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // User activity logs
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update, delete: if false; // Immutable logs
    }
    
    // Data exports
    match /dataExports/{exportId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Backup and recovery
    match /backups/{backupId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 