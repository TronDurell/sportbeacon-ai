# -------------------------------
# SportBeaconAI Frontend Environment Variables
# -------------------------------
# Copy this file to .env and fill in your actual values

# Firebase Web App Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe Public Key (for payments)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Feature Flags
VITE_ENABLE_LOCATION_THREADS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DIGESTS=true
VITE_ENABLE_PWA_INSTALL=true

# API Configuration
VITE_API_BASE_URL=https://api.sportbeaconai.com
VITE_DEV_MODE=true

# External Services
VITE_WEATHER_API_KEY=your_weather_api_key_here
VITE_SENTRY_DSN=your_sentry_dsn_here

# Development Settings
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# PWA Configuration
VITE_PWA_NAME=SportBeacon
VITE_PWA_SHORT_NAME=SportBeacon
VITE_PWA_THEME_COLOR=#111827
VITE_PWA_BACKGROUND_COLOR=#111827

# Performance Settings
VITE_ENABLE_SERVICE_WORKER=true
VITE_CACHE_STRATEGY=stale-while-revalidate
VITE_IMAGE_OPTIMIZATION=true

# Security Settings
VITE_ENABLE_CSP=true
VITE_ALLOWED_ORIGINS=https://sportbeaconai.com,https://app.sportbeaconai.com