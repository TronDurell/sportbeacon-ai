# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# OpenAI Configuration (Whisper API Fallback)
OPENAI_API_KEY=your_openai_api_key

# FastAPI CORS (comma-separated explicit origins; do not use *)
# Defaults include local Vite and https://sportbeacon-ai.vercel.app
# Preview hosts match CORS_ALLOW_ORIGIN_REGEX.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://sportbeacon-ai.vercel.app
CORS_ALLOW_ORIGIN_REGEX=^https://sportbeacon-ai-git-[a-z0-9-]+-trondurells-projects\.vercel\.app$

# Incomplete coach, highlight, and extended-schedule routes stay off unless explicitly enabled.
ENABLE_EXPERIMENTAL_ROUTES=false
ENABLE_PRODUCT_ROUTES=true
ENABLE_AUTHENTICATED_PROFILE_ROUTES=true
ENABLE_API_DOCS=true
# Required. Recognized values: development, test, staging, production.
# Missing, blank, or unrecognized values fail closed (health only).
APP_ENV=development

# Legacy Express / WebSocket configuration (not used by the FastAPI shell)
CLIENT_ORIGIN=http://localhost:3000
PORT=3001

# S3 and CloudFront Configuration
S3_BUCKET_NAME=sportbeacon-media
CLOUDFRONT_DISTRIBUTION_ID=your_distribution_id
CLOUDFRONT_DOMAIN=your_cloudfront_domain

# Audio Processing
MAX_AUDIO_SIZE_MB=100
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
THROTTLE_INTERVAL_MS=1000

# Logging
LOG_LEVEL=info
VOICE_LOGS_DIR=logs/voice 