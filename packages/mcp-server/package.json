{
  "name": "@sportbeacon/mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for SportBeaconAI agent tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "zod": "^3.22.4",
    "firebase-admin": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "rate-limiter-flexible": "^5.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "tsx": "^4.6.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4",
    "vite": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^6.3.0",
    "eslint": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "tools",
    "sportbeacon",
    "firebase"
  ],
  "author": "SportBeaconAI Team",
  "license": "MIT"
}
