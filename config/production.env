# SportBeaconAI Production Environment Configuration
# This file contains all environment variables required for production deployment

# Firebase Configuration
FIREBASE_PROJECT_ID=sportbeacon-ai-production
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"sportbeacon-ai-production","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@sportbeacon-ai-production.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40sportbeacon-ai-production.iam.gserviceaccount.com"}
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=sportbeacon-ai-production.firebaseapp.com
FIREBASE_STORAGE_BUCKET=sportbeacon-ai-production.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_ACCOUNT_ID=acct_your-stripe-account-id

# Database Configuration
DATABASE_URL=your-production-database-url
DATABASE_HOST=your-database-host
DATABASE_PORT=5432
DATABASE_NAME=sportbeacon_ai_production
DATABASE_USER=your-database-user
DATABASE_PASSWORD=your-database-password

# Authentication Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-for-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secure-jwt-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# Vercel Configuration
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# Monitoring Configuration
GRAFANA_API_KEY=your-grafana-api-key
GRAFANA_URL=https://grafana.sportbeacon.ai
PROMETHEUS_URL=http://localhost:9090

# Alerting Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-slack-webhook
ALERT_EMAIL=alerts@sportbeacon.ai
PAGERDUTY_API_KEY=your-pagerduty-api-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@sportbeacon.ai

# File Storage Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=sportbeacon-ai-production-media
AWS_CLOUDFRONT_DISTRIBUTION_ID=your-cloudfront-distribution-id

# Redis Configuration (for caching)
REDIS_URL=redis://your-redis-host:6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# External API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
SENDGRID_API_KEY=your-sendgrid-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Security Configuration
CORS_ORIGIN=https://sportbeacon-ai.vercel.app,https://admin.sportbeacon-ai.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENCRYPTION_KEY=your-encryption-key-for-sensitive-data

# Performance Configuration
NODE_ENV=production
PORT=3000
MAX_FILE_SIZE=10485760
COMPRESSION_LEVEL=6
CACHE_TTL=3600

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=logs/sportbeacon-ai.log
SENTRY_DSN=your-sentry-dsn

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_MONITORING=true
ENABLE_ALERTING=true
ENABLE_CACHING=true
ENABLE_COMPRESSION=true
ENABLE_RATE_LIMITING=true

# AI/ML Configuration
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions

# Payment Processing Configuration
PAYMENT_PROCESSOR=stripe
PAYMENT_WEBHOOK_TIMEOUT=30000
PAYMENT_RETRY_ATTEMPTS=3
PAYMENT_MIN_AMOUNT=100
PAYMENT_MAX_AMOUNT=1000000

# User Management Configuration
USER_REGISTRATION_ENABLED=true
USER_EMAIL_VERIFICATION_REQUIRED=true
USER_PASSWORD_MIN_LENGTH=8
USER_SESSION_TIMEOUT=3600000

# Content Management Configuration
MEDIA_UPLOAD_ENABLED=true
MEDIA_MAX_FILE_SIZE=10485760
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/gif,video/mp4,video/webm
MEDIA_STORAGE_PROVIDER=aws-s3

# Notification Configuration
PUSH_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=false
NOTIFICATION_BATCH_SIZE=100

# Analytics Configuration
ANALYTICS_PROVIDER=firebase
ANALYTICS_TRACKING_ID=your-analytics-tracking-id
ANALYTICS_ENABLED=true
ANALYTICS_SAMPLE_RATE=1.0

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PROVIDER=aws-s3

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.
MAINTENANCE_ALLOWED_IPS=127.0.0.1,::1

# Development/Testing Configuration (should be false in production)
DEBUG=false
TESTING=false
MOCK_EXTERNAL_SERVICES=false
SKIP_AUTHENTICATION=false

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

# API Configuration
API_VERSION=v1
API_RATE_LIMIT_ENABLED=true
API_DOCUMENTATION_ENABLED=false
API_METRICS_ENABLED=true

# Webhook Configuration
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5000
WEBHOOK_SIGNATURE_VERIFICATION=true

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=3600
CACHE_TTL_USER=1800
CACHE_TTL_CONTENT=7200
CACHE_TTL_ANALYTICS=300

# Queue Configuration
QUEUE_ENABLED=true
QUEUE_PROVIDER=redis
QUEUE_MAX_CONCURRENT_JOBS=10
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000

# Search Configuration
SEARCH_ENABLED=true
SEARCH_PROVIDER=elasticsearch
SEARCH_INDEX_PREFIX=sportbeacon_ai_production
SEARCH_MAX_RESULTS=100

# CDN Configuration
CDN_ENABLED=true
CDN_PROVIDER=cloudfront
CDN_DOMAIN=cdn.sportbeacon.ai
CDN_CACHE_TTL=86400

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/sportbeacon-ai.crt
SSL_KEY_PATH=/etc/ssl/private/sportbeacon-ai.key
SSL_CA_PATH=/etc/ssl/certs/sportbeacon-ai-ca.crt

# Load Balancer Configuration
LOAD_BALANCER_ENABLED=true
LOAD_BALANCER_HEALTH_CHECK_PATH=/health
LOAD_BALANCER_HEALTH_CHECK_INTERVAL=30
LOAD_BALANCER_HEALTH_CHECK_TIMEOUT=5

# Auto-scaling Configuration
AUTO_SCALING_ENABLED=true
AUTO_SCALING_MIN_INSTANCES=2
AUTO_SCALING_MAX_INSTANCES=10
AUTO_SCALING_TARGET_CPU_UTILIZATION=70

# Disaster Recovery Configuration
DR_ENABLED=true
DR_BACKUP_LOCATION=us-west-2
DR_RECOVERY_TIME_OBJECTIVE=3600
DR_RECOVERY_POINT_OBJECTIVE=300

# Compliance Configuration
GDPR_COMPLIANCE_ENABLED=true
CCPA_COMPLIANCE_ENABLED=true
SOC2_COMPLIANCE_ENABLED=true
HIPAA_COMPLIANCE_ENABLED=false

# Performance Monitoring Configuration
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_METRICS_ENABLED=true
PERFORMANCE_TRACING_ENABLED=true
PERFORMANCE_PROFILING_ENABLED=false

# Error Tracking Configuration
ERROR_TRACKING_ENABLED=true
ERROR_TRACKING_PROVIDER=sentry
ERROR_TRACKING_SAMPLE_RATE=1.0
ERROR_TRACKING_MAX_BREADCRUMBS=100

# Security Monitoring Configuration
SECURITY_MONITORING_ENABLED=true
SECURITY_SCANNING_ENABLED=true
SECURITY_VULNERABILITY_SCANNING_ENABLED=true
SECURITY_PENETRATION_TESTING_ENABLED=false

# Data Retention Configuration
DATA_RETENTION_ENABLED=true
DATA_RETENTION_PERIOD_DAYS=2555
DATA_ARCHIVAL_ENABLED=true
DATA_DELETION_ENABLED=true

# API Gateway Configuration
API_GATEWAY_ENABLED=true
API_GATEWAY_RATE_LIMITING_ENABLED=true
API_GATEWAY_CACHING_ENABLED=true
API_GATEWAY_MONITORING_ENABLED=true

# Microservices Configuration
MICROSERVICES_ENABLED=true
MICROSERVICES_DISCOVERY_ENABLED=true
MICROSERVICES_LOAD_BALANCING_ENABLED=true
MICROSERVICES_CIRCUIT_BREAKER_ENABLED=true

# Event Streaming Configuration
EVENT_STREAMING_ENABLED=true
EVENT_STREAMING_PROVIDER=kafka
EVENT_STREAMING_TOPIC_PREFIX=sportbeacon_ai_production
EVENT_STREAMING_PARTITIONS=3

# Machine Learning Configuration
ML_ENABLED=true
ML_MODEL_ENDPOINT=https://ml.sportbeacon.ai
ML_MODEL_VERSION=v1.0.0
ML_PREDICTION_TIMEOUT=10000

# Real-time Configuration
REALTIME_ENABLED=true
REALTIME_PROVIDER=firebase
REALTIME_MAX_CONNECTIONS=10000
REALTIME_MESSAGE_TTL=300

# Integration Configuration
INTEGRATION_WEBHOOKS_ENABLED=true
INTEGRATION_API_ENABLED=true
INTEGRATION_MONITORING_ENABLED=true
INTEGRATION_RETRY_ENABLED=true

# Custom Configuration
CUSTOM_FEATURE_FLAGS={"beta_features":false,"experimental_features":false,"debug_mode":false}
CUSTOM_API_ENDPOINTS={"health":"/health","metrics":"/metrics","status":"/status"}
CUSTOM_MONITORING={"custom_metrics":true,"custom_alerts":true,"custom_dashboards":true} 